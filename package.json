{
  "name": "gork",
  "type": "module",
  "version": "1.0.0",
  "description": "An AI-powered Discord bot built using Bun, TypeScript and ESLint.",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/techwithanirudh/gork",
  "repository": {
    "type": "git",
    "url": "https://github.com/techwithanirudh/gork.git"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "check:spelling": "cspell -c .cspell.jsonc --no-progress --no-summary --no-must-find-files --unique --cache",
    "check:unsafe": "ultracite fix --unsafe true .",
    "check:write": "ultracite fix .",
    "deploy": "bun run src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "lefthook install",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@exalabs/ai-sdk": "^1.0.5",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@cspell/dict-bash": "^4.2.2",
    "@cspell/dict-redis": "^1.0.7",
    "@date-fns/tz": "^1.4.1",
    "@deepgram/sdk": "^5.0.0",
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@elevenlabs/elevenlabs-js": "^2.43.0",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@pinecone-database/pinecone": "^7.2.0",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/functions": "^3.4.3",
    "ai": "^6.0.168",
    "ai-fallback": "^2.0.1",
    "ai-retry": "^1.5.0",
    "compromise": "^14.15.0",
    "cspell": "^10.0.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.3.0",
    "jsonrepair": "^3.14.0",
    "langfuse-vercel": "^3.38.20",
    "libsodium-wrappers": "^0.8.4",
    "lint-staged": "^16.4.0",
    "node-crc": "^4.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prism-media": "^1.3.5",
    "redis": "^5.12.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/bun": "1.3.12",
    "@types/node": "24",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "drizzle-kit": "^0.31.10",
    "ultracite": "7.6.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@discordjs/opus",
    "esbuild",
    "ffmpeg-static",
    "node-crc",
    "unrs-resolver"
  ]
}
