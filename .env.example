# ---------------------------------------------------------------------------------------------------------
# Discord
# This is the bot token and client ID for your Discord application.
# You can create a new application and get the token from the Discord Developer Portal.
# @see https://discord.com/developers/applications
# ---------------------------------------------------------------------------------------------------------
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# The User ID of the bot owner, used for various administrative tasks.
DISCORD_OWNER_ID=your_discord_owner_id_here 
# The default guild ID where the bot will operate.
DISCORD_DEFAULT_GUILD_ID=your_discord_default_guild_id_here

# ---------------------------------------------------------------------------------------------------------
# AI
# AI Services used for chatting and other functionalities.
# You can configure which provider you'd like to use, in the src/lib/ai/providers.ts file.
# @see https://ai-sdk.dev/docs/foundations/providers-and-models
# ---------------------------------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# HACKCLUB_API_KEY=your_hackclub_api_key_here
# COHERE_API_KEY=your_cohere_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Redis
# For caching — standard Redis connection URL
# Example: redis://:password@localhost:6379/0
# ---------------------------------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------------------------------------
# Logging
# Standard logging configuration
# ---------------------------------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# ---------------------------------------------------------------------------------------------------------
# Memory
# A global memory service for storing and retrieving data.
# ---------------------------------------------------------------------------------------------------------
# MEM0_API_KEY=your_mem0_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Voice Channel
# Talk in voice channels using Deepgram and ElevenLabs.
# @see https://deepgram.com/
# @see https://elevenlabs.io/
# ---------------------------------------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Search
# Search the web using ExaAI.
# @see https://exa.ai/
# ---------------------------------------------------------------------------------------------------------
EXA_API_KEY=your_exa_api_key_here

# ---------------------------------------------------------------------------------------------------------
# Observability
# Monitor and debug AI applications.
# @see https://langfuse.com/
# ---------------------------------------------------------------------------------------------------------
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASEURL="https://cloud.langfuse.com" # Use "https://us.cloud.langfuse.com" for US region
